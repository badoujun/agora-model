/data/
*.db
*.db-wal
*.db-shm
master.key

# ---- 本地环境与临时文件 ----
.env
config.json
*.local.*
mock-upstream.log

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 工具运行时目录（Reasonix 等 agent 宿主）----
.reasonix/
.codegraph/

# ---- Go ----
*.test
*.out
