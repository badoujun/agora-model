# 复制为 .env 后填写；.env 已在 .gitignore 中忽略。
# 容器内监听 0.0.0.0，ADMIN_PASSWORD 必填（Web 控制台登录密码）。
ADMIN_PASSWORD=change-me

# 推荐：主密钥用环境变量而不是 /data/master.key 文件。
# 生成方式：openssl rand -hex 32
# 丢失后已加密的供应商凭证无法恢复；已有数据卷时不要随意更换。
GW_MASTER_KEY=

# 宿主机端口绑定：127.0.0.1 仅本机可用；要让局域网 Agent 访问改成 0.0.0.0。
AGORAMODEL_BIND=127.0.0.1

# 注入二进制的版本号（留空则使用程序内置版本号）。
AGORAMODEL_VERSION=

# 时区（影响日志与统计页的按日聚合）。
TZ=Asia/Shanghai

# 构建镜像源：默认使用 docker.aityp.com 收录的华为云 SWR 地址。
# 外网可直连 Docker Hub 时可取消注释，改用官方镜像。
# NODE_IMAGE=node:22-alpine
# GO_IMAGE=golang:1.25-alpine
# RUNTIME_IMAGE=alpine:3.22
# NPM_REGISTRY=https://registry.npmjs.org
# GOPROXY=https://proxy.golang.org,direct
# APK_MIRROR=dl-cdn.alpinelinux.org
